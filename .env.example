# Server configuration (all optional in development)
ADDR=:8080
DATABASE_URL=postgres://localhost:5432/graphly?sslmode=disable
# Serve the built frontend from this directory (production). Leave unset in dev and use Vite.
STATIC_DIR=
# Mark the session cookie Secure. Must be true behind HTTPS.
SECURE_COOKIES=false
# Extra origins allowed to call the API with credentials, comma-separated.
ALLOWED_ORIGINS=

# ---- Forecasting ----
# The server computes forecasts and the daily history. "Today" is decided in this timezone
# (IANA name, e.g. Europe/Berlin), so working-day math matches where the team plans.
FORECAST_TIMEZONE=UTC
# How often the background job recomputes each project with open work.
FORECAST_INTERVAL=15m
# Once a project has this many finished, estimated issues, its Monte Carlo overruns are learned
# from its own history (estimate vs. working days from start to done) instead of the defaults.
CALIBRATION_MIN_ISSUES=20
# Each issue type needs this many of its own samples; otherwise it uses the project-wide range.
CALIBRATION_MIN_PER_TYPE=5

# ---- Notifications ----
# People involved in a project are told when its ship date moves by at least this many working days.
SHIP_DATE_MOVE_THRESHOLD=2
# Hosts a user's Slack incoming webhook URL may point at (comma-separated). Anything else is refused,
# so the delivery worker can't be aimed at internal services.
SLACK_WEBHOOK_HOSTS=hooks.slack.com

# Public address of the app, used for links in emails and Slack messages and for OAuth redirects.
PUBLIC_URL=http://localhost:8080

# Outgoing email for notifications (any SMTP server or provider relay: SendGrid, Postmark, SES…).
# Leave SMTP_HOST empty to turn email off; port 465 uses implicit TLS, others STARTTLS when offered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Graphly <graphly@example.com>

# Notification delivery: gather a burst into one digest for this long, poll this often, and give
# up after this many attempts (backoff doubles from 30s, capped at 1h).
NOTIFY_DIGEST_WINDOW=2m
NOTIFY_POLL_INTERVAL=5s
NOTIFY_MAX_ATTEMPTS=8
