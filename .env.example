# Server configuration (all optional in development)
ADDR=:8080
DATABASE_URL=postgres://localhost:5432/graphly?sslmode=disable
# Serve the built frontend from this directory (production). Leave unset in dev and use Vite.
STATIC_DIR=
# Mark the session cookie Secure. Must be true behind HTTPS.
SECURE_COOKIES=false
# Extra origins allowed to call the API with credentials, comma-separated.
ALLOWED_ORIGINS=
# Header your proxy puts the client's IP in (e.g. Fly-Client-IP, X-Real-IP). Used for rate limits
# and the audit log. Leave empty when clients connect directly; never trust a header clients can set.
CLIENT_IP_HEADER=

# ---- Forecasting ----
# The server computes forecasts and the daily history. "Today" is decided in this timezone
# (IANA name, e.g. Europe/Berlin), so working-day math matches where the team plans.
FORECAST_TIMEZONE=UTC
# How often the background job recomputes each project with open work.
FORECAST_INTERVAL=15m
# Once a project has this many finished, estimated issues, its Monte Carlo overruns are learned
# from its own history (estimate vs. working days from start to done) instead of the defaults.
CALIBRATION_MIN_ISSUES=20
# Each issue type needs this many of its own samples; otherwise it uses the project-wide range.
CALIBRATION_MIN_PER_TYPE=5

# ---- Notifications ----
# People involved in a project are told when its ship date moves by at least this many working days.
SHIP_DATE_MOVE_THRESHOLD=2
# Hosts a user's Slack incoming webhook URL may point at (comma-separated). Anything else is refused,
# so the delivery worker can't be aimed at internal services.
SLACK_WEBHOOK_HOSTS=hooks.slack.com

# Public address of the app, used for links in emails and Slack messages and for OAuth redirects.
PUBLIC_URL=http://localhost:8080

# Outgoing email for notifications (any SMTP server or provider relay: SendGrid, Postmark, SES…).
# Leave SMTP_HOST empty to turn email off; port 465 uses implicit TLS, others STARTTLS when offered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Graphly <graphly@example.com>

# Notification delivery: gather a burst into one digest for this long, poll this often, and give
# up after this many attempts (backoff doubles from 30s, capped at 1h).
NOTIFY_DIGEST_WINDOW=2m
NOTIFY_POLL_INTERVAL=5s
NOTIFY_MAX_ATTEMPTS=8

# Sign in with Google / GitHub (OAuth). A provider appears on the login page when its client id is
# set. Redirect URI to register: $PUBLIC_URL/api/auth/oauth/google/callback (or /github/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Rate limits and caps (per server instance) ----
# Requests per minute allowed for each personal API token (see /api/openapi.yaml).
API_TOKEN_RATE_LIMIT=600
# State-changing requests per user per minute (web app and API tokens together).
WRITE_RATE_LIMIT=300
# Jira/Linear imports (dry runs included) per user per hour.
IMPORT_RATE_LIMIT=20
# GitHub/GitLab webhook deliveries per project per minute (checked before the signature).
WEBHOOK_RATE_LIMIT=600
# Unauthenticated requests (sign-up, invite links, OAuth, provider list) per IP per minute.
# Login has its own fixed limit of 10 per minute per IP.
PUBLIC_RATE_LIMIT=120
# New issues (and imports) are refused past this many issues in one project.
MAX_ISSUES_PER_PROJECT=20000

# ---- Security ----
# After a webhook secret is regenerated, the previous one keeps working this long (0 = not at all).
WEBHOOK_SECRET_GRACE=24h
# Strict-Transport-Security max-age. Defaults to 1 year when SECURE_COOKIES=true, otherwise off.
HSTS_MAX_AGE=

# ---- Observability (see docs/operations.md) ----
# json (default) or text.
LOG_FORMAT=json
# debug, info, warn or error.
LOG_LEVEL=info
# One log line per request (health checks and /metrics excluded).
LOG_REQUESTS=true
# /metrics on the main port needs "Authorization: Bearer $METRICS_TOKEN"; unset hides it (404).
METRICS_TOKEN=
# Also serve /metrics without auth on this private address (e.g. :9090). Don't expose it publicly.
METRICS_ADDR=

# ---- Tests and tooling only ----
# Database the Go tests wipe and use: TEST_DATABASE_URL=postgres://localhost:5432/graphly_test?sslmode=disable
# Set GRAPHLY_REQUIRE_DB=1 to make database tests fail instead of skip when it's unreachable (CI does).
# MULTI_INSTANCE_URLS=http://localhost:8080,http://localhost:8081 runs TestMultiInstanceProcesses
# against running servers (scripts/multi-instance.sh sets it).
