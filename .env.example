# Server configuration (all optional in development)
ADDR=:8080
DATABASE_URL=postgres://localhost:5432/graphly?sslmode=disable
# Serve the built frontend from this directory (production). Leave unset in dev and use Vite.
STATIC_DIR=
# Mark the session cookie Secure. Must be true behind HTTPS.
SECURE_COOKIES=false
# Extra origins allowed to call the API with credentials, comma-separated.
ALLOWED_ORIGINS=
